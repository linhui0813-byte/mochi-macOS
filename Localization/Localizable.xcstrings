    "You have 200 or more user templates. Edit or remove an existing template before adding another." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザテンプレートが200個以上あります。追加する前に、既存のテンプレートを編集または削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 템플릿이 200개 이상입니다. 다른 템플릿을 추가하기 전에 기존 템플릿을 편집하거나 제거하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已有 200 个或更多自定模板。请先编辑或移除现有模板，再添加新的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已有 200 個以上的使用者範本。請先編輯或移除現有範本，再加入新的範本。"
          }
        }
      }
    },
    "Your Codex sign-in has expired. Use Codex once so it can renew the sign-in, or sign in again, then retry." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codexのサインインの有効期限が切れています。Codexを一度使用してサインインを更新するか、もう一度サインインしてから、再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex 로그인이 만료되었습니다. Codex를 한 번 사용하여 로그인을 갱신하거나 다시 로그인한 다음 다시 시도하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Codex 登录已过期。请使用一次 Codex 以续期登录，或重新登录，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Codex 登入已過期。請使用一次 Codex 讓它更新登入，或重新登入，然後重試。"
          }
        }
      }
    },
    "Your Codex sign-in was rejected. Sign in through Codex again, then retry." : {
