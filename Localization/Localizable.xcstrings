          }
        }
      }
    },
    "%@’s reply could not be saved because its audio file could not be written. Retry the reply." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオファイルを書き込めなかったため、%@の返信を保存できませんでした。返信を再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오 파일을 기록할 수 없어 %@의 답장을 저장하지 못했습니다. 답장을 다시 시도하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存%@的回复，因为无法写入其音频文件。请重试该回复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法儲存 %@ 的回覆，因為無法寫入其音訊檔案。請重試回覆。"
          }
        }
      }
    },
    "%@’s reply could not be saved because the disk is full. Free some space, then retry the reply." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクがいっぱいのため、%@の返信を保存できませんでした。空き領域を確保してから、返信を再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크가 가득 차서 %@의 답장을 저장하지 못했습니다. 공간을 확보한 다음 답장을 다시 시도하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存%@的回复，因为磁盘已满。请释放一些空间，然后重试该回复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁碟已滿，無法儲存 %@ 的回覆。請釋放一些空間，然後重試回覆。"
          }
        }
      }
    },
    "%@’s reply was saved without its audio because the audio file could not be written." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオファイルを書き込めなかったため、%@の返信は音声なしで保存されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오 파일을 기록할 수 없어 %@의 답장이 오디오 없이 저장되었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@的回复已保存，但未包含音频，因为无法写入音频文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的回覆已儲存，但因無法寫入音訊檔案而未包含音訊。"
          }
        }
      }
    },
    "%@’s reply was saved without its audio because the disk is full. Free some space before the next reply." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクがいっぱいのため、%@の返信は音声なしで保存されました。次の返信の前に空き領域を確保してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크가 가득 차서 %@의 답장이 오디오 없이 저장되었습니다. 다음 답장 전에 공간을 확보하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@的回复已保存，但未包含音频，因为磁盘已满。请在下一次回复前释放一些空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁碟已滿，%@ 的回覆儲存時未包含音訊。請在下一則回覆前釋放一些空間。"
          }
        }
      }
    },
    "%@’s server could not be found. Check your network or DNS settings, then retry." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のサーバが見つかりませんでした。ネットワークまたはDNSの設定を確認してから、再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 서버를 찾을 수 없습니다. 네트워크 또는 DNS 설정을 확인한 다음 다시 시도하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到 %@ 的服务器。请检查网络或 DNS 设置，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到 %@ 的伺服器。請檢查網路或 DNS 設定，然後重試。"
          }
        }
      }
    },
