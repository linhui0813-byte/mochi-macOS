    "Your reference is ready. Listen, then try saying it yourself." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お手本の準備ができました。聴いてから、自分で言ってみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고 음성이 준비되었습니다. 들은 다음 직접 말해 보십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
