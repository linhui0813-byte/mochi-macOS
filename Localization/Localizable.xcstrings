          }
        }
      }
    },
    "Mochi could not move your library into its folder: %@ Your data has not been changed. Reveal the data folder from Settings to review it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochiはライブラリを自身のフォルダに移動できませんでした：%@ データは変更されていません。「設定」からデータフォルダを表示して確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi가 라이브러리를 Mochi 폴더로 옮길 수 없습니다: %@ 데이터는 변경되지 않았습니다. 확인하려면 설정에서 데이터 폴더를 여십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 无法将你的资料库移到其文件夹：%@ 你的数据未被更改。请从“设置”中显示数据文件夹进行检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 無法將你的資料庫搬移到其檔案夾：%@ 你的資料未被更改。請從「設定」顯示資料檔案夾以檢查。"
          }
        }
      }
    },
    "Mochi couldn’t save your library" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochiはライブラリを保存できませんでした"
          }
