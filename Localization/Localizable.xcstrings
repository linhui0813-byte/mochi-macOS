    "The example did not match the sentence exactly. Generate it again; your sentence has not been changed." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お手本が文と完全には一致しませんでした。もう一度生成してください。文は変更されていません。"
          }
