    "%@ / %@" : {
      "shouldTranslate" : false
    },
    "%@ Your recording is saved." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 録音は保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 녹음은 저장되어 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 你的录音已保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 你的錄音已儲存。"
          }
        }
      }
    },
    "%@ credentials were rejected. Update them in Settings." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の認証情報が拒否されました。「設定」で更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 자격 증명이 거부되었습니다. 설정에서 업데이트하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 凭证被拒绝。请在“设置”中更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 憑證遭到拒絕。請在「設定」中更新。"
          }
        }
      }
    },
    "%@ did not respond in time. Retry in a moment." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が時間内に応答しませんでした。少し待ってから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 제시간에 응답하지 않았습니다. 잠시 후 다시 시도하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未及时响应。请稍后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未及時回應。請稍後重試。"
          }
        }
      }
    },
    "%@ is speaking" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が話しています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 말하는 중"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
