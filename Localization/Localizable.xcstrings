    },
    "Talk with %@ in English. When you get stuck,\nwe’ll find the words and practise them in your own voice." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@と英語で話しましょう。言葉に詰まったら、\n一緒に言い方を見つけて、自分の声で練習しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@와(과) 영어로 이야기해 보십시오. 말이 막히면\n알맞은 표현을 찾아 직접 목소리로 연습할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用英语和%@聊天。卡壳时，\n我们会帮你找到合适的说法，并用你自己的声音练习。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用英文和 %@ 聊天。卡住的時候，\n我們會一起找出說法，並用你自己的聲音練習。"
          }
        }
      }
    },
    "Tell %@ how you want to practise. These settings apply to future replies." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのように練習したいかを%@に伝えましょう。これらの設定は今後の返信に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에게 어떻게 연습하고 싶은지 알려 주십시오. 이 설정은 이후 답장에 적용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉%@你想如何练习。这些设置将应用于之后的回复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告訴 %@ 你想怎麼練習。這些設定會套用到之後的回覆。"
          }
        }
      }
    },
    "Template catalog changed. Restart listing from offset 0." : {
