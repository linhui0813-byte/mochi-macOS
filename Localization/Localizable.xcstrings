    "Character name must contain 1–%lld characters, at most %lld KB, without line breaks, control characters or text-direction overrides." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャラクター名は1〜%lld文字、%lld KB以内で、改行、制御文字、テキスト方向のオーバーライドを含まないようにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캐릭터 이름은 1–%lld자, 최대 %lld KB여야 하며 줄 바꿈, 제어 문자 또는 텍스트 방향 재정의 문자를 포함할 수 없습니다."
          }
