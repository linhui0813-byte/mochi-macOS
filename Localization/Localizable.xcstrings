            "value" : "%@ 正在說話"
          }
        }
      }
    },
    "%@ is thinking…" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が考え中…"
          }
        },
        "ko" : {
