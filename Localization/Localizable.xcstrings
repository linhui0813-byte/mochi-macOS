          }
        }
      }
    },
    "%@ must contain text and fit within %lld characters and %lld KB." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にはテキストを入力し、%lld文字・%lld KB以内に収めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에는 텍스트가 있어야 하며 %lld자 및 %lld KB 이내여야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@必须包含文本，且不超过 %lld 个字符和 %lld KB。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 必須包含文字，且不超過 %lld 個字元和 %lld KB。"
          }
        }
      }
    },
    "%@ must fit within %lld characters and %lld KB." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は%lld文字・%lld KB以内に収めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) %lld자 및 %lld KB 이내여야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@不能超过 %lld 个字符和 %lld KB。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不能超過 %lld 個字元和 %lld KB。"
          }
        }
      }
    },
    "%@ redirected the request, which Mochi refuses for your security. A proxy or captive portal may be interfering." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がリクエストをリダイレクトしましたが、Mochiは安全のためこれを拒否します。プロキシまたはキャプティブポータルが干渉している可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 요청을 리디렉션했으며, Mochi는 보안을 위해 이를 거부합니다. 프록시 또는 종속 포털이 방해하고 있을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 重定向了请求，出于安全考虑，Mochi 拒绝了该重定向。可能是代理或强制门户在干扰。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 重新導向了要求，為了你的安全，Mochi 已拒絕。可能有代理伺服器或強制登入網頁造成干擾。"
          }
        }
      }
    },
    "%@ refused the connection. A firewall or proxy may be blocking it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が接続を拒否しました。ファイアウォールまたはプロキシがブロックしている可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 연결을 거부했습니다. 방화벽 또는 프록시가 차단하고 있을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒绝了连接。可能有防火墙或代理正在阻止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒絕了連線。可能有防火牆或代理伺服器正在阻擋。"
          }
        }
      }
    },
    "%@ request failed (HTTP %lld). Check Settings and retry." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@へのリクエストが失敗しました（HTTP %lld）。「設定」を確認して再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 요청이 실패했습니다(HTTP %lld). 설정을 확인하고 다시 시도하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 请求失败（HTTP %lld）。请检查“设置”后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 要求失敗（HTTP %lld）。請檢查設定並重試。"
          }
        }
      }
    },
    "%@ response was too large." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の応答が大きすぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 응답이 너무 큽니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 响应过大。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的回應太大。"
          }
        }
      }
    },
    "%@ returned an invalid response." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が無効な応答を返しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 유효하지 않은 응답을 반환했습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 返回了无效的响应。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 傳回了無效的回應。"
          }
        }
      }
    },
    "%@ usage limit reached. Retry later." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の使用量の上限に達しました。しばらくしてから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 사용 한도에 도달했습니다. 나중에 다시 시도하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已达到 %@ 使用限额。请稍后重试。"
          }
        },
